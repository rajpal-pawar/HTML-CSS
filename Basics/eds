            <a href="#" class="text-3xl font-display uppercase tracking-widest">
                Echelon
            </a>
            <button id="menu-close-button" class="text-lg font-bold uppercase border-2 border-light-text px-4 py-2 hover:bg-brand-red hover:text-white hover:border-brand-red transition-colors">
