<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Echelon Dev Society</title>
    
    <!-- 1. Load Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- 2. Load Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <!-- Anton for headings, Inter for body -->
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- 3. Configure Tailwind -->
    <script>
        tailwind.config = {
            darkMode: 'class', // Enable dark mode
            theme: {
                extend: {
                    fontFamily: {
                        // 'Anton' for bold, impactful headings
                        'display': ['Anton', 'sans-serif'], 
                        // 'Inter' for readable body text
                        'sans': ['Inter', 'sans-serif'],
                    },
                    colors: {
                        // Dark blue/gray background
                        'dark-bg': '#222831',
                        // Off-white text
                        'light-text': '#EEEEEE',
                        // Bright red accent
                        'brand-red': '#EF233C',
                    }
                },
            },
        }
    </script>

    <!-- 4. Custom Styles -->
    <style>
        /* Set the base font for the entire site */
        body {
            font-family: 'Inter', sans-serif;
            transition: background-color 0.3s ease-in-out, color 0.3s ease-in-out;
        }

        /* Set all headings to the display font */
        h1, h2, h3, h4, h5, h6 {
            font-family: 'Anton', sans-serif;
            letter-spacing: 0.05em; /* Add a little spacing */
            text-transform: uppercase;
        }

        /* Hide scrollbar when menu is open */
        .menu-open {
            overflow: hidden;
        }

        /* Custom styles for the sharp-edged look */
        .section-border {
            border: 2px solid #222831;
        }
        .dark .section-border {
            border-color: #EEEEEE;
        }
        .header-border {
            border-bottom: 2px solid #222831;
        }
        .dark .header-border {
            border-bottom-color: #EEEEEE;
        }

        /* --- MARQUEE / TICKER ANIMATION --- */
        .marquee {
            overflow: hidden;
            position: relative;
            white-space: nowrap;
        }
        .marquee-content {
            display: inline-block;
            /* Adjust animation duration for speed */
            animation: marquee 20s linear infinite;
        }
        .marquee-content span {
            font-family: 'Anton', sans-serif;
            font-size: 3rem;
            padding: 0 2rem;
        }
        
        @keyframes marquee {
            0% { transform: translateX(0); }
            100% { transform: translateX(-100%); }
        }
        /* --- END MARQUEE --- */
    </style>
</head>

<!-- We start in dark mode by default for this aesthetic -->
