                <!-- Desktop/Mobile Menu Button -->
                <button id="menu-open-button" class="text-lg font-bold uppercase border-2 border-light-text px-4 py-2 hover:bg-brand-red hover:text-white hover:border-brand-red transition-colors">
                    Menu
                </button>
            </div>
        </div>
    </header>

    <!-- ========== FULLSCREEN MENU ========== -->
    <div id="fullscreen-menu" class="hidden fixed inset-0 z-50 bg-dark-bg p-4">
